[Desktop Entry]
Name=__PACKAGE_DISPLAY_NAME__
Comment=__PACKAGE_COMMENT__
Exec=AppRun %u
Icon=__PACKAGE_NAME__
Terminal=false
Type=Application
Categories=Development;
MimeType=x-scheme-handler/codex;x-scheme-handler/codex-browser-sidebar;
StartupNotify=true
StartupWMClass=__PACKAGE_NAME__
X-GNOME-WMClass=__PACKAGE_NAME__
X-AppImage-Version=__VERSION__
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=env CHROME_DESKTOP=__PACKAGE_NAME__.desktop CODEX_MULTI_LAUNCH=1 AppRun --new-instance
