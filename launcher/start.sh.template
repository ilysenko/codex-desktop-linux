#!/bin/bash
set -Eeuo pipefail

CODEX_LINUX_APP_ID="${CODEX_LINUX_APP_ID:-__CODEX_LINUX_APP_ID__}"
CODEX_LINUX_APP_DISPLAY_NAME="${CODEX_LINUX_APP_DISPLAY_NAME:-__CODEX_LINUX_APP_DISPLAY_NAME__}"
CODEX_LINUX_APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODEX_LINUX_APP_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$CODEX_LINUX_APP_ID"
CODEX_LINUX_APP_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$CODEX_LINUX_APP_ID"
export CODEX_LINUX_APP_ID CODEX_LINUX_APP_DISPLAY_NAME CODEX_LINUX_APP_DIR
export CODEX_LINUX_APP_STATE_DIR CODEX_LINUX_APP_CACHE_DIR
export CHROME_DESKTOP="${CHROME_DESKTOP:-${CODEX_LINUX_APP_ID}.desktop}"
export BAMF_DESKTOP_FILE_HINT="${BAMF_DESKTOP_FILE_HINT:-/usr/share/applications/${CODEX_LINUX_APP_ID}.desktop}"

HOOK_ROOT="$CODEX_LINUX_APP_DIR/.codex-linux"
CHATGPT_BINARY="$CODEX_LINUX_APP_DIR/ChatGPT"

usage() {
    cat <<EOF
Usage: $0 [--diagnose] [ChatGPT arguments or URI]

Runs OpenAI's official Linux ChatGPT executable from the custom
$CODEX_LINUX_APP_ID distribution. Arguments and deep-link URIs are forwarded
unchanged after enabled feature hooks have run.
EOF
}

diagnose() {
    local failed=0
    for required in \
        "$CHATGPT_BINARY" \
        "$CODEX_LINUX_APP_DIR/resources/app.asar" \
        "$CODEX_LINUX_APP_DIR/resources/codex" \
        "$CODEX_LINUX_APP_DIR/resources/rg" \
        "$CODEX_LINUX_APP_DIR/resources/codex-code-mode-host"; do
        if [ -e "$required" ]; then
            printf 'ok: %s\n' "$required"
        else
            printf 'missing: %s\n' "$required" >&2
            failed=1
        fi
    done
    if [ -r /proc/sys/kernel/unprivileged_userns_clone ] &&
       [ "$(cat /proc/sys/kernel/unprivileged_userns_clone)" = "0" ]; then
        printf '%s\n' \
            'warning: unprivileged user namespaces are disabled; install the native package AppArmor policy or enable user namespaces. The launcher will not disable Chromium sandboxing.' >&2
    fi
    return "$failed"
}

report_daily_usage() {
    (
        [ "${CODEX_LINUX_DISABLE_USAGE_REPORTING:-0}" != "1" ] || exit 0
        command -v curl >/dev/null 2>&1 || exit 0

        local report_day
        local usage_state_dir="$CODEX_LINUX_APP_STATE_DIR/usage-reporting"

        umask 077
        report_day="$(date -u +%F)" || exit 0
        mkdir -p "$usage_state_dir" || exit 0

        # The per-day directory is an atomic, cross-process marker. Reserve the
        # day before starting the request so even failed requests are attempted
        # at most once and concurrent launches cannot report twice.
        mkdir "$usage_state_dir/$report_day" || exit 0

        # GoatCounter classifies missing, short, and HTTP-client User-Agents as
        # bots. This fixed value carries no installation or system data; its
        # stable space-and-slash shape only keeps the count out of that filter.
        curl --disable \
            --silent \
            --fail \
            --get \
            --connect-timeout 2 \
            --max-time 3 \
            --output /dev/null \
            --user-agent "ChatGPTCommunity/1 Usage" \
            --data-urlencode "p=/app-launch" \
            --data-urlencode "ns=1" \
            "https://gary.goatcounter.com/count"
    ) >/dev/null 2>&1 &
}

run_hook_directory() {
    local directory="$1"
    local phase="$2"
    local hook
    [ -d "$directory" ] || return 0
    while IFS= read -r -d '' hook; do
        CODEX_LINUX_FEATURE_HOOK_PHASE="$phase" "$hook" "${ORIGINAL_ARGS[@]}"
    done < <(find "$directory" -maxdepth 1 -type f -perm -u+x -print0 | sort -z)
}

load_environment_hooks() {
    local file
    [ -d "$HOOK_ROOT/env.d" ] || return 0
    while IFS= read -r -d '' file; do
        set -a
        # shellcheck disable=SC1090
        . "$file"
        set +a
    done < <(find "$HOOK_ROOT/env.d" -maxdepth 1 -type f -print0 | sort -z)
}

canonicalize_codex_home() {
    local requested_codex_home="${CODEX_HOME:-$HOME/.codex}"
    local physical_codex_home

    [ -d "$requested_codex_home" ] || return 0
    if [ "$requested_codex_home" = "-" ]; then
        requested_codex_home="./-"
    fi
    physical_codex_home="$(CDPATH='' cd -P -- "$requested_codex_home" && pwd -P)"
    export CODEX_HOME="$physical_codex_home"
}

refresh_legacy_bundled_plugin_cache() {
    local plugin_id="$1"
    local bundled_plugin="$CODEX_LINUX_APP_DIR/resources/plugins/openai-bundled/plugins/$plugin_id"
    local bundled_manifest="$bundled_plugin/.codex-plugin/plugin.json"
    local cache_root="${CODEX_HOME:-$HOME/.codex}/plugins/cache/openai-bundled/$plugin_id"
    local cache_dir
    local cache_manifest
    local cache_client
    local replacement
    local backup

    [ -f "$bundled_manifest" ] && [ -d "$cache_root" ] || return 0
    while IFS= read -r -d '' cache_dir; do
        cache_manifest="$cache_dir/.codex-plugin/plugin.json"
        cache_client="$cache_dir/scripts/browser-client.mjs"
        [ -f "$cache_manifest" ] && [ -f "$cache_client" ] && [ ! -L "$cache_client" ] || continue
        cmp -s "$bundled_manifest" "$cache_manifest" || continue
        grep -Eq 'codexLinuxPerUserBrowserSocketDir|codexLinuxIabSocketScope' "$cache_client" || continue

        replacement="${cache_dir}.community-refresh.$$"
        backup="${cache_dir}.community-legacy.$$"
        if mkdir -m 0700 "$replacement" &&
           cp -a --no-preserve=ownership "$bundled_plugin/." "$replacement/" &&
           mv "$cache_dir" "$backup" &&
           mv "$replacement" "$cache_dir"; then
            if ! rm -rf -- "$backup"; then
                printf 'warning: refreshed %s plugin but could not remove its legacy cache backup: %s\n' "$plugin_id" "$backup" >&2
            fi
            printf 'Refreshed legacy %s plugin cache from the official Linux payload: %s\n' "$plugin_id" "$cache_dir" >&2
        else
            if [ -d "$backup" ] && [ ! -e "$cache_dir" ]; then
                if ! mv "$backup" "$cache_dir" 2>/dev/null; then
                    printf 'warning: legacy %s plugin cache rollback requires manual recovery: %s\n' "$plugin_id" "$backup" >&2
                fi
            fi
            rm -rf -- "$replacement" 2>/dev/null || true
            printf 'warning: could not refresh legacy %s plugin cache: %s\n' "$plugin_id" "$cache_dir" >&2
        fi
    done < <(find "$cache_root" -mindepth 1 -maxdepth 1 -type d ! -name '*.community-refresh.*' ! -name '*.community-legacy.*' -print0)
}

refresh_legacy_bundled_plugin_caches() {
    local plugin_appserver="${CODEX_HOME:-$HOME/.codex}/plugins/.plugin-appserver"

    refresh_legacy_bundled_plugin_cache browser
    refresh_legacy_bundled_plugin_cache chrome

    if [ -d "$plugin_appserver" ] && [ ! -L "$plugin_appserver" ] && [ -O "$plugin_appserver" ]; then
        chmod go-w "$plugin_appserver" 2>/dev/null ||
            printf 'warning: could not secure the Chrome app-server runtime directory: %s\n' "$plugin_appserver" >&2
    fi
}

load_electron_args() {
    local file
    local line
    [ -d "$HOOK_ROOT/electron-args.d" ] || return 0
    while IFS= read -r -d '' file; do
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ""|\#*) continue ;; esac
            ELECTRON_ARGS+=("$line")
        done < "$file"
    done < <(find "$HOOK_ROOT/electron-args.d" -maxdepth 1 -type f -print0 | sort -z)
}

load_user_electron_args_file() {
    local file="$1"
    local line
    local leading_space
    local trailing_space

    [ -f "$file" ] && [ -r "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        leading_space="${line%%[![:space:]]*}"
        line="${line#"$leading_space"}"
        trailing_space="${line##*[![:space:]]}"
        line="${line%"$trailing_space"}"
        case "$line" in ""|\#*) continue ;; esac
        ELECTRON_ARGS+=("$line")
    done < "$file"
}

load_user_electron_args() {
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

    load_user_electron_args_file "$config_home/electron-flags.conf"
    load_user_electron_args_file "$config_home/$CODEX_LINUX_APP_ID/electron-flags.conf"
}

run_launcher_hooks() {
    local hook
    local output
    local kind
    local payload
    local name
    [ -d "$HOOK_ROOT/launcher.d" ] || return 0
    while IFS= read -r -d '' hook; do
        output="$(CODEX_LINUX_FEATURE_HOOK_PHASE=launcher "$hook" "$@")"
        while IFS=' ' read -r kind payload; do
            [ -n "${kind:-}" ] || continue
            case "$kind" in
                env)
                    name="${payload%%=*}"
                    [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
                        printf 'Invalid environment assignment from %s: %s\n' "$hook" "$payload" >&2
                        return 1
                    }
                    export "$payload"
                    ;;
                electron-arg) ELECTRON_ARGS+=("$payload") ;;
                *) printf 'Unknown launcher hook directive from %s: %s\n' "$hook" "$kind" >&2; return 1 ;;
            esac
        done <<< "$output"
    done < <(find "$HOOK_ROOT/launcher.d" -maxdepth 1 -type f -perm -u+x -print0 | sort -z)
}

ORIGINAL_ARGS=("$@")
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --diagnose) diagnose; exit $? ;;
esac
[ -x "$CHATGPT_BINARY" ] || { printf 'ChatGPT executable is missing: %s\n' "$CHATGPT_BINARY" >&2; exit 1; }

ELECTRON_ARGS=("--class=$CODEX_LINUX_APP_ID")
load_environment_hooks
canonicalize_codex_home
refresh_legacy_bundled_plugin_caches
load_user_electron_args
load_electron_args
run_hook_directory "$HOOK_ROOT/prelaunch.d" prelaunch
run_launcher_hooks "${ELECTRON_ARGS[@]}" "${ORIGINAL_ARGS[@]}"

if [ -f "$HOOK_ROOT/codex-packaged-runtime.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOOK_ROOT/codex-packaged-runtime.sh"
    declare -F codex_packaged_runtime_export_env >/dev/null && codex_packaged_runtime_export_env
    declare -F codex_packaged_runtime_prelaunch >/dev/null && codex_packaged_runtime_prelaunch
fi

report_daily_usage
run_hook_directory "$HOOK_ROOT/cold-start.d" cold-start &

if [ ! -d "$HOOK_ROOT/after-exit.d" ] ||
   ! find "$HOOK_ROOT/after-exit.d" -maxdepth 1 -type f -perm -u+x -print -quit | grep -q .; then
    exec "$CHATGPT_BINARY" "${ELECTRON_ARGS[@]}" "${ORIGINAL_ARGS[@]}"
fi

set +e
"$CHATGPT_BINARY" "${ELECTRON_ARGS[@]}" "${ORIGINAL_ARGS[@]}"
status=$?
set -e
run_hook_directory "$HOOK_ROOT/after-exit.d" after-exit
exit "$status"
