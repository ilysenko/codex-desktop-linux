{
  "entrypoints": [
    { "label": "omitted" },
    { "label": "null", "entrypoints": null },
    { "label": "empty", "entrypoints": {} },
    { "label": "patch", "entrypoints": { "patchDescriptors": "./patch.js" } },
    { "label": "stage", "entrypoints": { "stageHook": "./stage.sh" } },
    { "label": "cleanup", "entrypoints": { "cleanupHook": "./cleanup.sh" } },
    { "label": "all", "entrypoints": { "patchDescriptors": "./patch.js", "stageHook": "./stage.sh", "cleanupHook": "./cleanup.sh" } },
    { "label": "typo", "entrypoints": { "patchDescriptros": "./patch.js" }, "error": "patchDescriptros" },
    { "label": "retired", "entrypoints": { "patchMainBundle": "./patch.js" }, "error": "patchMainBundle" },
    { "label": "unknown", "entrypoints": { "patchDescriptors": "./patch.js", "other": "./other.js" }, "error": "other" },
    { "label": "array", "entrypoints": [], "error": "entrypoints must be an object" },
    { "label": "string", "entrypoints": "./patch.js", "error": "entrypoints must be an object" },
    { "label": "number", "entrypoints": 1, "error": "entrypoints must be an object" },
    { "label": "boolean", "entrypoints": false, "error": "entrypoints must be an object" }
  ],
  "defaultEnabled": [
    { "label": "omitted" },
    { "label": "false", "value": false },
    { "label": "true", "value": true, "error": "defaultEnabled true is not allowed" },
    { "label": "string-false", "value": "false", "error": "defaultEnabled must be a boolean" },
    { "label": "string-true", "value": "true", "error": "defaultEnabled must be a boolean" },
    { "label": "string-yes", "value": "yes", "error": "defaultEnabled must be a boolean" },
    { "label": "zero", "value": 0, "error": "defaultEnabled must be a boolean" },
    { "label": "one", "value": 1, "error": "defaultEnabled must be a boolean" },
    { "label": "null", "value": null, "error": "defaultEnabled must be a boolean" },
    { "label": "array", "value": [], "error": "defaultEnabled must be a boolean" },
    { "label": "object", "value": {}, "error": "defaultEnabled must be a boolean" }
  ],
  "internal": [
    { "label": "omitted" },
    { "label": "false", "value": false },
    { "label": "true", "value": true },
    { "label": "null", "value": null, "error": "internal must be a boolean" },
    { "label": "zero", "value": 0, "error": "internal must be a boolean" },
    { "label": "one", "value": 1, "error": "internal must be a boolean" },
    { "label": "string-false", "value": "false", "error": "internal must be a boolean" },
    { "label": "string-true", "value": "true", "error": "internal must be a boolean" },
    { "label": "array", "value": [], "error": "internal must be a boolean" },
    { "label": "object", "value": {}, "error": "internal must be a boolean" }
  ],
  "directories": [
    { "label": "public", "directory": "probe", "id": "probe" },
    { "label": "private", "directory": "local/private-probe", "id": "private-probe" },
    { "label": "alternate-root", "root": "alternate-features", "directory": "probe", "id": "probe" },
    { "label": "public-mismatch", "directory": "folder-name", "id": "different-id", "error": true },
    { "label": "private-mismatch", "directory": "local/folder-name", "id": "different-id", "error": true },
    { "label": "alternate-root-mismatch", "root": "alternate-features", "directory": "folder-name", "id": "different-id", "error": true }
  ]
}
