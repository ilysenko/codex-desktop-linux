{
  "id": "pet-overlay",
  "title": "Pet Overlay",
  "description": "Optional Linux avatar overlay placement and compositor hints.",
  "defaultEnabled": false,
  "entrypoints": {
    "patchDescriptors": "./patch.js",
    "stageHook": "./stage.sh"
  },
  "resources": [
    { "source": "kwin-bridge.cjs", "target": ".codex-linux/features/pet-overlay/kwin-bridge.cjs", "mode": "0644" },
    { "source": "kwin-script.cjs", "target": ".codex-linux/features/pet-overlay/kwin-script.cjs", "mode": "0644" }
  ],
  "runtimeHooks": {
    "launcher": {
      "source": "launcher-hook.sh",
      "name": "gpu-compositing-default.sh",
      "mode": "0755"
    }
  },
  "petOverlay": {
    "gravity": "bottom-right",
    "margin": 24,
    "miniScale": 0.7,
    "allWorkspaces": true,
    "alwaysOnTop": true,
    "skipTaskbar": true,
    "lockPosition": false,
    "mode": "interactive",
    "hyprland": true,
    "kwin": true,
    "niri": true
  }
}
