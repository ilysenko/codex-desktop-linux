+fn target_looks_like_terminal(target: &WindowInfo) -> bool {
+    let terminal_markers = [
+        "terminal",
+        "gnome-terminal",
+        "xterm",
+        "kitty",
+        "alacritty",
+        "wezterm",
+        "konsole",
+        "tilix",
+        "lxterminal",
+        "mate-terminal",
+        "terminator",
+        "foot",
+        "rxvt",
+    ];
+    [target.app_id.as_deref(), target.wm_class.as_deref(), target.title.as_deref()]
+        .into_iter()
+        .flatten()
+        .map(|value| value.to_ascii_lowercase())
+        .any(|value| terminal_markers.iter().any(|marker| value.contains(marker)))
+}
