{
  "id": "ui-tweaks",
  "title": "UI Tweaks",
  "description": "Optional UI customization patches for ChatGPT Community.",
  "defaultEnabled": false,
  "gentoo": {
    "supported": true,
    "dependencies": {
      "RDEPEND": ["sys-apps/util-linux"]
    }
  },
  "entrypoints": {
    "patchDescriptors": "./patch.js",
    "stageHook": "./stage.sh"
  },
  "runtimeHooks": {
    "prelaunch": {
      "source": "sync-desktop-icon.sh",
      "name": "dock-icon-cleanup.sh",
      "mode": "0755"
    }
  },
  "officialBundleAuditScenarios": [
    {
      "name": "custom-font-input",
      "settings": {
        "tweaks": {
          "appearance": {
            "customFontInput": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "extended-ui-font-size",
      "settings": {
        "tweaks": {
          "appearance": {
            "uiFontSize": {
              "enabled": true
            }
          }
        }
      }
    },
    {
      "name": "selected-text-more-details",
      "settings": {
        "tweaks": {
          "selection": {
            "moreDetails": {
              "enabled": true
            }
          }
        }
      }
    }
  ],
  "tweaks": {
    "appearance": {
      "customFontInput": {
        "enabled": false
      },
      "dockIcon": {
        "enabled": false
      },
      "uiFontSize": {
        "enabled": false,
        "max": 24
      }
    },
    "home": {
      "suggestedPrompts": {
        "enabled": false
      }
    },
    "modelPicker": {
      "showModelsByDefault": {
        "enabled": false
      }
    },
    "reasoning": {
      "keepEffortLabelsEnglish": {
        "enabled": true
      }
    },
    "selection": {
      "moreDetails": {
        "enabled": false
      }
    },
    "sidebar": {
      "projectName": {
        "enabled": true,
        "style": "font-weight: 700 !important;"
      }
    }
  }
}
